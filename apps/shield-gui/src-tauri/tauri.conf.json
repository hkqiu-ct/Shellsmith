{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellsmith",
  "version": "1.8.0",
  "identifier": "dev.mocika.shield-gui",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shellsmith",
        "width": 960,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "icon": [
      "icons/png/32x32.png",
      "icons/png/128x128.png",
      "icons/png/256x256.png",
      "icons/png/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../../tools/apktool_3.0.3.jar": "tools/apktool.jar",
      "../../../tools/apksigner.jar": "tools/apksigner.jar",
      "../../../tools/xop-pvm2-packer.jar": "tools/xop-pvm2-packer.jar",
      "../../../tools/licenses/XopProtector-LICENSE.txt": "licenses/XopProtector-LICENSE.txt",
      "../../../tools/licenses/XopProtector-NOTICE.txt": "licenses/XopProtector-NOTICE.txt",
      "../../../shield-stub/build/outputs/resources/resources.zip": "resources/resources.zip",
      "../../../shield-stub/build/outputs/resources/resources-api19.zip": "resources/resources-api19.zip",
      "../../../shield-stub/build/outputs/resources/mocika-play-delivery-api.jar": "resources/mocika-play-delivery-api.jar"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQjZGREMxMzUwNzJFMjAKUldRZ0xnYzF3ZjIyL3dvN1BwMmdrSGdsVFViRDRIYlB2U29NRkUxd0Ryb21LRkFaaHdFRGNZMGkK",
      "endpoints": ["https://github.com/kairowan/Shellsmith/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
